{
  "name": "chocobo-frontend",
  "version": "0.1.0",
  "description": "Frontend Angular do ERP Chocobo.",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
